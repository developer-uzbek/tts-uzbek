# ==============================================================================
# Uzbekcha TTS — Environment Configuration Example
# ==============================================================================

# Server Configuration
PORT=5000
PUBLIC_BASE_URL=https://tts-uzbek.onrender.com

# Telegram Bot Integration (Optional - app runs web/API without it)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=Uzbekcha_tts_bot
ADMIN_ID=123456789
STORAGE_CHAT_ID=
SUBSCRIBE_REQUIRED=false
TELEGRAM_CHANNEL=

# TTS Limits & Performance
RATE_PER_MIN=40
MAX_CHARS=5000
CACHE_MB=24
MAX_JOBS=4
DEFAULT_AUDIO_FILENAME=uzbekcha_tts
